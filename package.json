{
  "name": "cypher-widget",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI quota monitor for Windows and macOS",
  "author": "Cypher",
  "repository": {
    "type": "git",
    "url": "https://github.com/A-Arnaud/Cypher.git"
  },
  "homepage": "https://github.com/A-Arnaud/Cypher#readme",
  "bugs": {
    "url": "https://github.com/A-Arnaud/Cypher/issues"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build && node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:clean-machine": "node scripts/test-clean-machine.cjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "preview": "vite --host 127.0.0.1",
    "build:test": "node scripts/build-test.cjs",
    "security:scan": "node scripts/check-publication.cjs",
    "security:release": "node scripts/check-release-security.cjs && node scripts/check-publication.cjs --artifacts",
    "security:secrets": "node scripts/run-gitleaks.cjs",
    "test:corners": "node scripts/test-window-corners.cjs",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "test:mac": "vitest run --config vitest.mac.config.ts"
  },
  "build": {
    "appId": "local.cypher.widget",
    "productName": "Cypher",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "dist/native/**",
      "dist/main/hidden-child.cjs"
    ],
    "files": [
      "dist/main/index.cjs",
      "dist/main/hidden-child.cjs",
      "dist/preload/index.cjs",
      "dist/renderer/**/*",
      "dist/assets/icon.png",
      "dist/native/Cypher.Taskbar.exe",
      "dist/native/LOGOS-LICENSE*.txt",
      "package.json",
      "!node_modules/**",
      "dist/assets/trayTemplate*.png",
      "dist/native/codex/**",
      "dist/assets/THIRD-PARTY-UPDATES.txt"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "assets/icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "A-Arnaud",
          "repo": "Cypher"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": false,
      "include": "native/installer.nsh",
      "artifactName": "Cypher-Setup-${version}-win-x64.exe"
    },
    "portable": {
      "artifactName": "Cypher-${version}-win-x64.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/logo-source.png",
      "identity": "-",
      "artifactName": "Cypher-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "beforePack": "scripts/check-codex-target.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@openai/codex": "0.164.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
